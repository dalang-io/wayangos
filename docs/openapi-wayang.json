  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Tokens have a scope: `ro` reads (and may check/plan), `rw` may also change the configuration on a server started with --rw, `admin` may also do the sensitive actions a tool marks. With mutual TLS the client certificate is required **and** the token is still checked."
      }
    },
    "schemas": {
      "Issue": {
        "type": "object",
        "properties": {
          "level": {
            "enum": [
              "error",
              "warning"
            ]
          },
          "what": {
            "type": "string"
          },
          "msg": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "level",
          "what",
          "msg"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "ok": {
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "issues": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Issue"
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "ok",
          "error"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "rw": {
            "type": "boolean"
          },
          "tls": {
            "type": "boolean"
          },
          "mtls": {
            "type": "boolean"
          }
        },
        "additionalProperties": true,
        "required": [
          "version"
        ],
        "description": "Harmless liveness data; tools add their own fields."
      },
      "AuditEntry": {
        "type": "object",
        "properties": {
          "ts": {
            "type": "integer"
          },
          "method": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "ok": {
            "type": "boolean"
          },
          "remote": {
            "type": "string"
          },
          "actor": {
            "type": "string",
            "description": "the token's label"
          },
          "scope": {
            "enum": [
              "ro",
              "rw",
              "admin"
            ]
          },
          "key": {
            "type": [
              "string",
              "null"
            ]
          },
          "rev": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "ts",
          "method",
          "path",
          "status"
        ]
      },
      "Revision": {
        "type": "object",
        "properties": {
          "rev": {
            "type": "integer"
          },
          "time": {
            "type": "string"
          },
          "comment": {
            "type": "string"
          },
          "rolled_back": {
            "type": "boolean"
          },
          "active": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "rev"
        ]
      },
      "AuditList": {
        "type": "object",
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEntry"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "entries"
        ]
      }
    },
    "responses": {
      "E400": {
        "description": "bad request (a malformed body, a missing or forbidden confirm window, a bad parameter)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E401": {
        "description": "no or wrong bearer token (also: with mutual TLS the certificate alone is not enough)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E403": {
        "description": "`read_only` (the server was not started with --rw) or `forbidden` (the token's scope is too low)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E404": {
        "description": "no such route or revision",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E405": {
        "description": "wrong method for this path (see `Allow`)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E409": {
        "description": "the engine refused (no nft, a failed apply, nothing pending to confirm); the reason is in plain words",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E413": {
        "description": "request body over 1 MiB",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E422": {
        "description": "validation: `error.issues` lists what is wrong; nothing was stored or applied",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E423": {
        "description": "locked: a commit is already waiting for confirmation",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E429": {
        "description": "rate limited, or too many failed tokens from this address (`Retry-After`)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E502": {
        "description": "the update channel is unreachable",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E503": {
        "description": "too many connections or event streams",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  },
  "x-wayang-contract": "1"
}
