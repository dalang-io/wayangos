# WAYANG_BASE: defconfig-qemu
#
# WayangOS x86_64 Intel i915 GPU kernel fragment.
# Enables the Direct Rendering Manager core plus the Intel
# integrated-graphics driver on top of the QEMU base config.
#
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_I915=y

# Bare metal (e.g. ThinkStation P320 Tiny): NVMe boot disk, UEFI framebuffer
# until i915 takes over, and the common USB-to-Ethernet adapters
CONFIG_BLK_DEV_NVME=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB_EFI=y
CONFIG_EFIVAR_FS=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
# CoreChip/Davicom USB 10/100 dongles (e.g. 0fe6:9702 SR9700, 0fe6:9700)
CONFIG_USB_NET_SR9700=y
CONFIG_USB_NET_SR9800=y
CONFIG_USB_NET_DM9601=y
# PCIe NICs: Intel I350/I340 (igb), I225/I226 (igc) and 10G (ixgbe, i40e) —
# the usual multi-port firewall cards. Onboard I219 (e1000e) and Realtek
# (r8169) come from the base config.
CONFIG_IGB=y
CONFIG_IGC=y
CONFIG_IXGBE=y
CONFIG_I40E=y
# SAS HBAs and hardware RAID: LSI/Broadcom SAS2/3 (mpt3sas), MegaRAID/PERC
# (megaraid_sas), HPE Smart Array (smartpqi, hpsa), and the older LSI SAS1068
# (mptsas, also what QEMU's mptsas1068 emulates)
CONFIG_SCSI_MPT3SAS=y
CONFIG_MEGARAID_SAS=y
CONFIG_SCSI_SMARTPQI=y
CONFIG_SCSI_HPSA=y
CONFIG_FUSION=y
CONFIG_FUSION_SAS=y
# USB sticks the installer reads SSH keys from
CONFIG_EXFAT_FS=y
# Intel WiFi (PCI iwlwifi) and Bluetooth (USB btusb, e.g. 8087:0aa7 with an
# AC 3165/8260/8265/AX200 companion). Firmware is bundled from
# $BUILD/wifi/firmware into /lib/firmware (see scripts/fetch-sources.sh).
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_FW_LOADER=y
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=y
CONFIG_IWLMVM=y
CONFIG_IWLDVM=y
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HCIBTUSB=y
# Firewall: nftables (inet = IPv4 + IPv6 in one table), NAT, conntrack and the
# flowtable fast path, for wayang-fw (/usr/sbin/nft is bundled by
# scripts/build-nft.sh). The base config only has iptables' filter table.
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_CONNTRACK_ZONES=y
CONFIG_NF_CONNTRACK_PROCFS=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CONNTRACK_TIMEOUT=y
CONFIG_NF_CONNTRACK_TIMESTAMP=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NF_NAT=y
CONFIG_NF_LOG_SYSLOG=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_NUMGEN=y
CONFIG_NFT_CT=y
CONFIG_NFT_CONNLIMIT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_NAT=y
CONFIG_NFT_QUOTA=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_HASH=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_SOCKET=y
CONFIG_NFT_SYNPROXY=y
CONFIG_NF_FLOW_TABLE=y
CONFIG_NF_FLOW_TABLE_INET=y
CONFIG_NFT_FLOW_OFFLOAD=y
# Router data plane (docs/ROUTER-TODO.md): the FULL block is enabled as of the
# M7 decision (docs/TODO-M7-UNBLOCK.md, 2026-09-29). Every group passed the
# bisect individually, the accumulated set showed no failing subset, and the one
# hang seen in the boot-count soak was a single, unreproduced cold-boot event
# (~16 s in, coinciding with the sr9700 link flap) — not a deterministic
# interaction. The shipped safety net (below) auto-recovers such a hang and the
# T1 primary-DHCP fix removes the 1.0.20 `gw=''` stall class. Driven by
# wayang-router. Baseline ONLY at boot: VLAN/bridge reach the data plane, while
# veth/macvlan/tun/VRF/WireGuard/GRE are created explicitly (dummy/bond/gre/
# ifb DO create netdevs at boot).
CONFIG_VLAN_8021Q=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_BRIDGE_IGMP_SNOOPING=y
CONFIG_STP=y
CONFIG_LLC=y
# veth / macvlan / TUN (created explicitly)
CONFIG_VETH=y
CONFIG_MACVLAN=y
CONFIG_TUN=y
# WireGuard (+ its crypto libs; the *_ARCH asm is the historical H2 suspect)
CONFIG_WIREGUARD=y
CONFIG_CRYPTO_LIB_CHACHA=y
CONFIG_CRYPTO_LIB_CHACHA_ARCH=y
CONFIG_CRYPTO_LIB_POLY1305=y
CONFIG_CRYPTO_LIB_POLY1305_ARCH=y
CONFIG_CRYPTO_LIB_CURVE25519=y
CONFIG_CRYPTO_LIB_CURVE25519_ARCH=y
# VRF + policy routing / multipath
CONFIG_NET_L3_MASTER_DEV=y
CONFIG_NET_VRF=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IPV6_SUBTREES=y
CONFIG_IP_ROUTE_MULTIPATH=y
CONFIG_IP_MULTIPLE_TABLES=y
# IPsec (xfrm)
CONFIG_INET_ESP=y
CONFIG_XFRM_INTERFACE=y
# dummy + bonding (create dummy0/bond0 at boot)
CONFIG_DUMMY=y
CONFIG_BONDING=y
# GRE / IPIP (create gre0/gretap0/erspan0/tunl0 at boot)
CONFIG_NET_IPIP=y
CONFIG_NET_IPGRE_DEMUX=y
CONFIG_NET_IPGRE=y
CONFIG_NET_UDP_TUNNEL=y
# QoS / shaping (create ifb0/ifb1 at boot)
CONFIG_IFB=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_U32=y
CONFIG_NET_CLS_FW=y
CONFIG_NET_ACT_POLICE=y
CONFIG_NET_ACT_MIRRED=y
CONFIG_NET_REDIRECT=y

# Shipped safety net (T2, docs/TODO-M7-UNBLOCK.md): the remote-bisect safety
# net (scripts/bisect-router-opts.sh safety_opts) baked into the released
# kernel, so 1.0.20's 04:48 uplink stall can never again strand a headless box.
# Watchdogs: the P320 Tiny (i3-7100, Sunrise Point PCH) exposes the Intel TCO
# watchdog via i2c-i801 (already =y in the base config); lpc_ich covers older
# ICH chipsets and QEMU q35; i6300esb is what scripts/test-selftest-qemu.sh
# emulates for the proof; soft watchdog is the universal fallback. BusyBox
# `watchdog` opens /dev/watchdog (wayang-selftest pets it).
CONFIG_WATCHDOG_CORE=y
CONFIG_ITCO_WDT=y
CONFIG_LPC_ICH=y
CONFIG_I6300ESB_WDT=y
CONFIG_SOFT_WATCHDOG=y
# DEBUG_KERNEL only unlocks the detector options below (compare the resolved
# .config, see docs/ROUTER-KERNEL-BISECT.md).
CONFIG_DEBUG_KERNEL=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
# Built-in cmdline, appended to whatever GRUB passes (wayang/grub-disk.cfg:
# loglevel=3 wayang.data=... wayang.slot=...), so installer, both slots and
# every update inherit the safety net without touching the template.
# wayang.selftest=120 defers `wayang mark-ok` to the boot self-test: the slot
# confirms only if the gateway still answers after 120 s, else
# `wayang update --fallback` + reboot; a hang/panic resets the box and GRUB's
# 3-attempt budget falls back on its own (docs/ROUTER-KERNEL-BISECT.md).
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="panic=10 oops=panic softlockup_panic=1 hardlockup_panic=1 hung_task_panic=1 nmi_watchdog=1 wayang.selftest=120"
